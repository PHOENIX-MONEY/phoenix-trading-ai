# Phoenix environment variables (backend)
# Copy this file to .env and fill in real values before running.
# Values here are placeholders and MUST NOT be committed.

# --- Database ---
# Default points at the local docker-compose Postgres (postgres:16) from /infra.
# For production/Supabase, replace with the Supabase pooling string
# (Dashboard -> Project Settings -> Database).
DATABASE_URL=postgresql://phoenix:phoenix@localhost:5432/phoenix

# --- Redis (docker-compose redis:7 service) ---
# Native Windows runs reach it via localhost; inside the compose network the
# backend service gets REDIS_URL=redis://redis:6379/0 automatically.
REDIS_URL=redis://localhost:6379/0

# --- Supabase (hosted Postgres — optional, for production) ---
SUPABASE_URL=<your-supabase-url>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- MetaTrader 5 (native local bridge, Windows only) ---
# Credentials of the MT5 trading account you log into with the locally
# installed MetaTrader 5 desktop terminal.
MT5_LOGIN=<your-mt5-login>
MT5_PASSWORD=<your-mt5-password>
MT5_SERVER=<your-broker-server>

# --- Market data (Phase 2) ---
# Primary symbol the system trades and ingests by default.
PRIMARY_SYMBOL=EURUSD
# Comma-separated list of MT5 timeframes to ingest each poll.
MARKET_DATA_TIMEFRAMES=M15,H1,H4
# Polling interval in seconds (default 30).
MARKET_DATA_POLL_INTERVAL_SEC=30
# How many candles to request per symbol/timeframe each poll.
MARKET_DATA_FETCH_COUNT=200
# Redis stream for new-candle events (published by the market data engine).
CANDLE_STREAM=phoenix:candles:new

# --- Risk Engine (safety-critical, NO defaults — set explicitly) ---
# Max % of account equity risked on a single trade (e.g. 1.0 = 1%).
# Suggested conservative starting point: 0.5 - 1.0
RISK_MAX_PER_TRADE_PCT=1.0

# Max % of the day's starting equity that may be lost before trading auto-halts.
# Suggested conservative starting point: 2.0 - 3.0
RISK_MAX_DAILY_LOSS_PCT=3.0

# Max number of concurrently open positions.
# Suggested conservative starting point: 2 - 3
RISK_MAX_CONCURRENT_POSITIONS=3

# Optional: path to a kill-switch flag file. When this file contains
# "1"/"true"/"yes"/"on", evaluate_trade() rejects every trade unconditionally.
# A future dashboard will toggle this. Leave empty to disable the flag file.
RISK_KILL_SWITCH_PATH=

# --- Strategy / Decision engine (Phase 4) ---
# Moving-average crossover: BUY on golden cross, SELL on death cross.
STRATEGY_FAST_PERIOD=10
STRATEGY_SLOW_PERIOD=30
STRATEGY_STOP_LOSS_PIPS=50
STRATEGY_TAKE_PROFIT_PIPS=100
# Pip value of the traded symbol (0.0001 for 5-digit FX pairs like EURUSD).
STRATEGY_PIP_SIZE=0.0001
# How many recent candles to load from Postgres for each evaluation.
STRATEGY_LOOKBACK=200
# Timeframe the decision engine trades.
STRATEGY_TIMEFRAME=H1
# SAFETY: defaults to true. The engine logs what it WOULD trade without
# sending orders. Set to false only when you are ready to trade live.
STRATEGY_DRY_RUN=true